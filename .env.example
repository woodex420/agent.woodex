# ===== Woodex Interior — environment variables =====
# Copy to .env.local and fill in real values. All values below are OPTIONAL
# unless marked REQUIRED when that feature is enabled.

# --- Sanity CMS ---
# Set to "true" to switch content sources from static files to Sanity.
# When "false" or unset, the site uses the TS content under src/lib/content/*
# (fully static site — no credentials needed to build).
NEXT_PUBLIC_SANITY_ENABLED=false
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=          # server-only token for preview/draft reads
SANITY_REVALIDATE_SECRET=       # shared secret for Sanity webhook → /api/revalidate + /api/audit

# --- Studio auth (shared-secret gate at /studio) ---
STUDIO_PASSWORD=                # REQUIRED in production for /studio access
PREVIEW_SECRET=                 # shared secret for /api/draft/enable|share (can reuse STUDIO_PASSWORD)

# --- Lead pipeline (/api/lead, /api/subscribe) ---
# All destinations are optional; the lead API buffers locally and returns 200
# even when no destination is configured (dev mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads
# HubSpot (alternative to Supabase)
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Email delivery (Resend)
RESEND_API_KEY=
WOODEX_NOTIFICATION_EMAIL=hello@woodex.studio
# WhatsApp Business API (Cloud API) — optional
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=lead_received_15min
# Spam defense
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Distributed rate limiting (optional; multi-instance deployments) ---
# When set, /lib/rate-limit.ts uses Upstash Redis instead of in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA4_ID=

# --- Observability (optional) ---
SENTRY_DSN=
AXIOM_TOKEN=
